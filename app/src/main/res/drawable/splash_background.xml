<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand splash: solid colour, centred logo, wordmark at the bottom -->
    <item android:drawable="@color/splash_bg" />
    <item android:gravity="center" android:width="288dp" android:height="288dp"
        android:drawable="@drawable/splash_logo" />
    <item android:gravity="bottom|center_horizontal" android:width="200dp" android:height="80dp"
        android:bottom="60dp" android:drawable="@drawable/splash_wordmark" />
</layer-list>
